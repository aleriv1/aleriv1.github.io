  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "ant": "^0.0.0",
    "antd": "^5.24.4",
    "date-fns": "^4.1.0",
    "lodash": "^4.17.21",
    "react": "^19.0.0",
    "react-detect-offline": "^2.4.5",
    "react-dom": "^19.0.0",
    "react-scripts": "5.0.1",
    "sass": "^1.86.0",
